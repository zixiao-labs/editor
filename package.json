{
  "name": "@zixiao-labs/editor",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "lightning run tests/crdt tests/unit",
    "test:crdt": "lightning run tests/crdt",
    "test:types": "lightning run --typecheck --tsconfig tsconfig.json tests/types",
    "test:consumer": "tsc --noEmit -p tests/consumer/tsconfig.json && lightning run tests/consumer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "build": "tsdown src/index.ts --format esm --platform neutral --target es2022 --dts --tsconfig tsconfig.build.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@lightning-js/lightning": "^3.1.2",
    "@nasti-toolchain/nasti": "^2.7.0",
    "tsdown": "^0.23.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^7.0.2"
  }
}
